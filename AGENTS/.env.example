# AI Team Framework — MCP Server Environment
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────

# Your Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the path to OWNER_CONTEXT.md
# Default: the script searches standard locations automatically.
# OWNER_CONTEXT_PATH=/absolute/path/to/OWNER_CONTEXT.md

# ─────────────────────────────────────────────────────────────
# Optional: override model tiers (see AGENTS/models.js)
# Defaults shown below. Change to swap models without editing code.
# ─────────────────────────────────────────────────────────────

# Fast tier — used for FAST path and LOOP plan/step calls (cheapest)
# ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001

# Mid tier — used for LOOP synthesis and all PRISM lens calls
# ANTHROPIC_MODEL_MID=claude-sonnet-4-20250514

# Premium tier — used for PRISM final synthesis on high-stakes tools only
# ANTHROPIC_MODEL_PREMIUM=claude-opus-4-20250514
